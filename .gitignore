# Python bytecode / caches
__pycache__/
*.py[cod]

# Temporary artifacts (strict policy: keep temp outputs under tmp/)
tmp/*
!tmp/README.md
!tmp/logs/
tmp/logs/*
!tmp/logs/README.md

# OS-generated files (macOS / Windows)
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
